{
  "name": "lookon",
  "version": "1.0.0",
  "private": true,
  "description": "LookOn real-time virtual try-on for online clothing stores",
  "scripts": {
    "build": "esbuild src/realtime-tryon.js --bundle --minify --format=iife --global-name=LookOnRealtime --outfile=public/vendor/realtime-tryon.js --target=es2020",
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@decartai/sdk": "^0.2.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
