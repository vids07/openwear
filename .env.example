# Copy to .env and fill in. server.mjs loads it automatically (Node built-in).
# All values are optional — with none set, the app runs with the name+email
# dev login and the try-on in stub mode.

# Secret used to sign session + device cookies. Set a long random string in
# production so sessions survive restarts. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google sign-in (the verified "one per person" identity).
# Create an OAuth 2.0 Client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   http://127.0.0.1:5173/auth/google/callback   (and your production URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keep the name+email dev login available even when Google is configured.
# (It's automatically on whenever Google is NOT configured.)
# OPENWEAR_ALLOW_DEV_LOGIN=1

# Your OWN Decart platform key (https://platform.decart.ai) for the real
# try-on. Leave empty to run in stub mode (records + plays your clip back).
# When set, the flow records a short clip, uploads it with the chosen garment
# to Decart's Lucy VTON job API, polls, and plays the rendered result.
# Server-side only — it is never sent to the browser.
DECART_API_KEY=
# Optional: override the model or API base (defaults shown).
# DECART_MODEL=lucy-vton-3.5
# DECART_API_BASE=https://api.decart.ai/v1

# Optional overrides.
# PORT=5173
# HOST=127.0.0.1
# OPENWEAR_TRIAL_SECONDS=60
