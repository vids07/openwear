{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tryon",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // public/ is served as static assets; only the API and auth routes run the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tryon",
      // Replace with the id printed by: npx wrangler d1 create tryon
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret settings. Secrets (SESSION_SECRET, DECART_API_KEY,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) go in with `wrangler secret put`,
  // or in .dev.vars for local development.
  "vars": {
    "TRIAL_SECONDS": "60"
  }

  // To serve on your domain, uncomment once the old DNS record for it is removed:
  // , "routes": [{ "pattern": "tryon.indiclabs.ai", "custom_domain": true }]
}
