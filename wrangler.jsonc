{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tryon",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // public/ is served as static assets. The API, auth, and assets/ (so videos
  // get byte-range support) run the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/assets/*"]
  },
  "workers_dev": true,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tryon",
      "database_id": "77471d71-d4f0-4c9e-8ace-9274e67aa648",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret settings. Secrets (SESSION_SECRET, DECART_API_KEY,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) go in with `wrangler secret put`,
  // or in .dev.vars for local development.
  "vars": {
    "TRIAL_SECONDS": "30"
  },

  "routes": [{ "pattern": "tryon.indiclabs.ai", "custom_domain": true }]
}
